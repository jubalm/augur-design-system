{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "augur-theme",
  "type": "registry:theme",
  "title": "Augur Theme",
  "author": "jubalm",
  "description": "Augur semantic light/dark theme: generated base tokens, shadcn-compatible role mappings, focus and reduced-motion behavior, and self-hosted Sora + Schibsted Grotesk fonts.",
  "dependencies": [
    "@fontsource/sora@5.3.0",
    "@fontsource/schibsted-grotesk@5.3.0"
  ],
  "files": [
    {
      "path": "packages/design-system/src/styles/typography.css",
      "type": "registry:style",
      "target": "src/styles/augur-typography.css",
      "content": "/*\n * Typography role classes for @augur/design-system.\n *\n * Each class mirrors one `DESIGN.md` front-matter `typography` role,\n * keyed by the role name. Values are hand-authored to match `DESIGN.md`\n * exactly and verified against it by the fonts fixture driver\n * (`fixtures/verify-fonts.mjs`); the token pipeline (issue #3) generates\n * the primitive tokens, while role classes stay the maintained runtime\n * mapping. Do not add roles or values that are not in `DESIGN.md`.\n *\n * Families come from `./fonts.css` custom properties; font files are\n * delivered via `styles.css`. Weights rely on faces loaded by the pinned\n * `@fontsource` packages (Sora 400/600, Schibsted Grotesk 400) — the\n * editorial roles (issue 45) deliberately reuse\n * the 400 faces; no Sora Light dependency exists.\n */\n\n/* Base: body copy uses the secondary voice unless a role overrides it. */\nbody {\n  font-family: var(--augur-font-secondary);\n  font-weight: 400;\n}\n\n/* DESIGN.md `typography.display` — Sora 600, 40/44, -0.01em. */\n.augur-type-display {\n  font-family: var(--augur-font-primary);\n  font-weight: 600;\n  font-size: 40px;\n  line-height: 44px;\n  letter-spacing: -0.01em;\n}\n\n/* DESIGN.md `typography.heading-1` — Sora 600, 28/34, -0.005em. */\n.augur-type-heading-1 {\n  font-family: var(--augur-font-primary);\n  font-weight: 600;\n  font-size: 28px;\n  line-height: 34px;\n  letter-spacing: -0.005em;\n}\n\n/* DESIGN.md `typography.heading-2` — Sora 600, 20/26. */\n.augur-type-heading-2 {\n  font-family: var(--augur-font-primary);\n  font-weight: 600;\n  font-size: 20px;\n  line-height: 26px;\n}\n\n/* DESIGN.md `typography.body` — Schibsted Grotesk 400, 16/24. */\n.augur-type-body {\n  font-family: var(--augur-font-secondary);\n  font-weight: 400;\n  font-size: 16px;\n  line-height: 24px;\n}\n\n/* DESIGN.md `typography.control` — Sora 600, 14/20. */\n.augur-type-control {\n  font-family: var(--augur-font-primary);\n  font-weight: 600;\n  font-size: 14px;\n  line-height: 20px;\n}\n\n/* DESIGN.md `typography.ui` — Sora 400, 14/20. */\n.augur-type-ui {\n  font-family: var(--augur-font-primary);\n  font-weight: 400;\n  font-size: 14px;\n  line-height: 20px;\n}\n\n/* DESIGN.md `typography.metadata` — Schibsted Grotesk 400, 12/16. */\n.augur-type-metadata {\n  font-family: var(--augur-font-secondary);\n  font-weight: 400;\n  font-size: 12px;\n  line-height: 16px;\n}\n\n/* DESIGN.md `typography.editorial-title` — Sora 400, 40/48, -0.01em.\n   The editorial voice: long-form titles set regular so size\n   alone creates order. The 32/40 step below 600px is part of the\n   adopted role, per the visual direction contract. */\n.augur-type-editorial-title {\n  font-family: var(--augur-font-primary);\n  font-weight: 400;\n  font-size: 40px;\n  line-height: 48px;\n  letter-spacing: -0.01em;\n}\n\n/* DESIGN.md `typography.editorial-section` — Sora 400, 28/34, -0.005em. */\n.augur-type-editorial-section {\n  font-family: var(--augur-font-primary);\n  font-weight: 400;\n  font-size: 28px;\n  line-height: 34px;\n  letter-spacing: -0.005em;\n}\n\n/* DESIGN.md `typography.editorial-label` — Schibsted Grotesk 400,\n   12/16, +0.12em: short tracked uppercase labels. Wrapping is allowed;\n   the tracking is never reduced to fit. */\n.augur-type-editorial-label {\n  font-family: var(--augur-font-secondary);\n  font-weight: 400;\n  font-size: 12px;\n  line-height: 16px;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n}\n\n/* Adopted mobile steps for the editorial roles (visual direction\n   contract). The seven inherited roles have no mobile steps. */\n@media (max-width: 599px) {\n  .augur-type-editorial-title {\n    font-size: 32px;\n    line-height: 40px;\n  }\n\n  .augur-type-editorial-section {\n    font-size: 24px;\n    line-height: 32px;\n  }\n}\n"
    }
  ],
