---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/base";

const routes = [
  {
    label: "Foundations",
    links: [
      { href: "/getting-started", text: "Getting started" },
      { href: "/foundations/identity", text: "Brand identity" },
      { href: "/foundations/fonts", text: "Fonts and typography" },
      { href: "/foundations/color", text: "Color system" },
      { href: "/foundations/layout-geometry", text: "Layout and geometry" },
      { href: "/foundations/interaction", text: "Interaction" },
      { href: "/foundations/theming", text: "Theming" },
    ],
  },
  {
    label: "Components",
    links: [
      { href: "/components/button", text: "Button" },
      { href: "/components/card", text: "Card" },
      { href: "/components/dialog", text: "Dialog" },
      { href: "/components/input", text: "Input" },
    ],
  },
  {
    label: "Patterns and reference",
    links: [
      { href: "/patterns/page-header", text: "PageHeader" },
      { href: "/patterns/form-field", text: "FormField" },
      { href: "/patterns/empty-state", text: "EmptyState" },
      { href: "/patterns/reference-record", text: "Reference record" },
      { href: "/reference/package-entries", text: "Package entries" },
      { href: "/reference/component-conventions", text: "Component authoring" },
      { href: "/reference/contributing", text: "Contributing" },
    ],
  },
];
---
<BaseLayout
  title="Home"
  description="A shared interface language for Augur: foundations, components, and guidance for clear, consistent interfaces."
  shell={false}
>
  <section class="opening" aria-labelledby="opening-title">
    <div class="opening-rail">
      <p class="brand-lockup opening-lockup">
        <span class="augur-type-editorial-title opening-wordmark">Augur</span>
        <span class="augur-type-editorial-label brand-lockup-descriptor">Design system</span>
      </p>
      <p class="opening-source augur-type-metadata">
        Early development: the foundations are real and consumable today.
        Adopted values are recorded in{ " " }
        <a href="https://github.com/jubalm/augur-design-system/blob/main/DESIGN.md">DESIGN.md</a>{ " " }
        and the maintained foundation guidance.
      </p>
    </div>
    <div class="opening-message">
      <h1 id="opening-title" class="augur-type-editorial-title">Make what<br />matters clear.</h1>
      <span class="opening-signal" aria-hidden="true"></span>
      <p class="opening-lede augur-type-body">
        A shared interface language for Augur: foundations, components,
        and guidance for clear, consistent interfaces.
      </p>
      <a class="opening-action" href={withBase("/getting-started")}>
        Explore the foundations <span aria-hidden="true">→</span>
      </a>
    </div>
    <div class="opening-footer">
      <div>
        <span class="augur-type-editorial-label">Purpose</span>
        <p class="augur-type-body">Ask. Vote. Reach a result.</p>
      </div>
      <div>
        <span class="augur-type-editorial-label">Character</span>
        <p class="augur-type-body">Clear-eyed, credible, neutral, human.</p>
      </div>
      <div>
        <span class="augur-type-editorial-label">System</span>
        <p class="augur-type-body">One language. Two everyday themes.</p>
      </div>
    </div>
  </section>

  <section class="route-index" aria-label="Routes into the system">
    {routes.map((group) => (
      <div class="route-group">
        <span class="augur-type-editorial-label">{group.label}</span>
        <ul>
          {group.links.map((link) => (
            <li>
              <a class="augur-type-body" href={withBase(link.href)}>{link.text}</a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>
</BaseLayout>
