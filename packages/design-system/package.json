{
  "name": "@augur/design-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/styles.css",
    "./fonts.css": "./src/styles/fonts.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "dependencies": {
    "@fontsource/schibsted-grotesk": "5.3.0",
    "@fontsource/sora": "5.3.0"
  },
  "scripts": {
    "tokens:lint": "design.md lint ../../DESIGN.md",
    "tokens:generate": "bun src/tools/generate-tokens.ts",
    "tokens:check": "bun src/tools/generate-tokens.ts --check",
    "tokens:verify-failures": "bun src/tools/generate-tokens.ts --prove-failure"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@google/design.md": "0.4.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "react": "^19.2.8"
  }
}
